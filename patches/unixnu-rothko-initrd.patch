diff --git a/package/UniXNUPkg/Driver/UniXNURamDiskDxe/UniXNURamDiskDxe.c b/package/UniXNUPkg/Driver/UniXNURamDiskDxe/UniXNURamDiskDxe.c
index 7d4def5..7d1bba0 100644
--- a/package/UniXNUPkg/Driver/UniXNURamDiskDxe/UniXNURamDiskDxe.c
+++ b/package/UniXNUPkg/Driver/UniXNURamDiskDxe/UniXNURamDiskDxe.c
@@ -10,6 +10,7 @@
 #include <Library/DebugLib.h>
 #include <Library/FdtLib.h>
 #include <Library/HobLib.h>
+#include <Library/PcdLib.h>
 #include <Library/UefiBootServicesTableLib.h>
 #include <Protocol/BlockIo.h>
 #include <Protocol/DevicePath.h>
@@ -142,6 +143,9 @@ PublishInitrd (
   INT32       EndLength;
   UINT64      Start;
   UINT64      End;
+  UINT64      DiskOffset;
+  UINT64      DiskSize;
+  UINT64      InitrdSize;
   EFI_HANDLE  Handle;
 
   Chosen = FdtPathOffset (Fdt, "/chosen");
@@ -161,12 +165,30 @@ PublishInitrd (
 
   Start = ReadCells (StartProp, StartLength / 4);
   End   = ReadCells (EndProp, EndLength / 4);
-  if ((End <= Start) || (((End - Start) % RAM_BLOCK_SIZE) != 0)) {
-    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: initrd 0x%lx-0x%lx is not a whole number of sectors\n", Start, End));
+  if (End <= Start) {
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: invalid initrd range 0x%lx-0x%lx\n", Start, End));
     return;
   }
 
-  mRamBase                = (UINT8 *)(UINTN)Start;
+  InitrdSize = End - Start;
+  DiskOffset = FixedPcdGet64 (PcdUniXNURamDiskOffset);
+  DiskSize   = FixedPcdGet64 (PcdUniXNURamDiskSize);
+  if ((DiskOffset == 0) && (DiskSize == 0)) {
+    DiskSize = InitrdSize;
+  } else if ((DiskSize == 0) || (DiskOffset > InitrdSize) ||
+             (DiskSize > (InitrdSize - DiskOffset)))
+  {
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: invalid payload offset 0x%lx size 0x%lx in initrd size 0x%lx\n",
+      DiskOffset, DiskSize, InitrdSize));
+    return;
+  }
+
+  if ((DiskSize == 0) || ((DiskSize % RAM_BLOCK_SIZE) != 0)) {
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: payload size 0x%lx is not a whole number of sectors\n", DiskSize));
+    return;
+  }
+
+  mRamBase                = (UINT8 *)(UINTN)(Start + DiskOffset);
   mMedia.MediaId          = 1;
   mMedia.RemovableMedia   = FALSE;
   mMedia.MediaPresent     = TRUE;
@@ -175,7 +197,7 @@ PublishInitrd (
   mMedia.WriteCaching     = FALSE;
   mMedia.BlockSize        = RAM_BLOCK_SIZE;
   mMedia.IoAlign          = 1;
-  mMedia.LastBlock        = (End - Start) / RAM_BLOCK_SIZE - 1;
+  mMedia.LastBlock        = DiskSize / RAM_BLOCK_SIZE - 1;
 
   Handle = NULL;
   Status = gBS->InstallMultipleProtocolInterfaces (
@@ -186,7 +208,8 @@ PublishInitrd (
                   &mBlockIo,
                   NULL
                   );
-  DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: initrd block device 0x%lx size 0x%lx %r\n", Start, End - Start, Status));
+  DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: initrd block device 0x%lx size 0x%lx %r\n",
+    (UINT64)(UINTN)mRamBase, DiskSize, Status));
 }
 
 EFI_STATUS
